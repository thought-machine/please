# Declared in a package called "nested", so the subrepo is registered as nested/two - which is
# what makes resolving it look for a package called "nested" in the host repo first.
#
# N.B. path is relative to the repo root rather than to subb, which is where this is declared.
local_repository(
    name = "two",
    path = "subb/nested/two",
)
