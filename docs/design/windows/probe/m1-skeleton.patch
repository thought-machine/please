+//go:build !windows
+
+package core
+
+import "syscall"
+
+const (
+	plzLOCK_SH = syscall.LOCK_SH
+	plzLOCK_EX = syscall.LOCK_EX
+	plzLOCK_UN = syscall.LOCK_UN
+	plzLOCK_NB = syscall.LOCK_NB
+)
+
+func plzFlock(fd, how int) error { return syscall.Flock(fd, how) }
