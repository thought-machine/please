{{ if .ArcatHash }}
remote_file(
    name = "arcat",
    url = f"https://github.com/please-build/arcat/releases/download/v1.3.1/arcat-1.3.1-{CONFIG.HOSTOS}_{CONFIG.HOSTARCH}",
    out = "arcat{{ .ExeSuffix }}",
    binary = True,
    hashes = [
        "{{ .ArcatHash }}", # defined in internal_package.go
    ],
    visibility = ["PUBLIC"],
)
{{ end }}

remote_file(
    name = "download",
    url = f"{{ .ToolsURL }}",
    extract = True,
)

{{ range $tool := .Tools }}
genrule(
    name = "{{$tool}}".removesuffix(".jar"),
    cmd = f"mv $SRC/{{$tool}} $OUT",
    srcs = [":download"],
    outs = ["{{$tool}}"],
    visibility = ["PUBLIC"],
    binary = True,
)
{{ end }}

